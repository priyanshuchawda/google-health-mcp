{
  "name": "google-health-mcp",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "A personal Google Health API MCP server for local and authenticated Cloudflare Workers use.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/stdio.ts",
    "auth": "tsx src/cli.ts auth",
    "serve": "tsx src/stdio.ts",
    "doctor": "tsx src/cli.ts doctor",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsc -p tsconfig.build.json",
    "worker:dev": "wrangler dev",
    "worker:dry-run": "wrangler deploy --dry-run",
    "spec:update": "tsx scripts/update-spec.ts",
    "docs:data-types": "tsx scripts/render-data-types.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "google-auth-library": "^11.3.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261127.1",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.11",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "5.1.2",
    "wrangler": "4.168.0"
  }
}
