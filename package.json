{
  "name": "ghealth-mcp",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "A Google Health API MCP server for local stdio and self-hosted Cloudflare Workers.",
  "license": "MIT",
  "author": "Priyanshu Chawda",
  "homepage": "https://github.com/priyanshuchawda/google-health-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priyanshuchawda/google-health-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/priyanshuchawda/google-health-mcp/issues"
  },
  "keywords": [
    "google-health",
    "fitbit",
    "pixel-watch",
    "mcp",
    "model-context-protocol",
    "health-data"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "ghealth-mcp": "./dist/src/cli.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "dist/spec",
    "README.md",
    "PRIVACY.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "docs/data-types.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch src/stdio.ts",
    "auth": "tsx src/cli.ts auth",
    "serve": "tsx src/stdio.ts",
    "doctor": "tsx src/cli.ts doctor",
    "build:dashboard": "node scripts/build-dashboard.mjs",
    "smoke:package": "node scripts/package-smoke.mjs",
    "pretest": "node scripts/build-dashboard.mjs",
    "test": "vitest run",
    "test:browser": "node tests/browser/dashboard-smoke.mjs",
    "test:watch": "vitest",
    "pretypecheck": "node scripts/build-dashboard.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prebuild": "node scripts/build-dashboard.mjs",
    "build": "tsc -p tsconfig.build.json",
    "worker:dev": "wrangler dev",
    "preworker:dry-run": "node scripts/build-dashboard.mjs",
    "worker:dry-run": "wrangler deploy --dry-run",
    "spec:update": "tsx scripts/update-spec.ts",
    "docs:data-types": "tsx scripts/render-data-types.ts",
    "prepack": "npm run build && node scripts/prepare-package.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.4.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/server": "2.4.0",
    "@openai/mcp-extensions": "^0.2.1",
    "google-auth-library": "^11.3.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261127.1",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "26.6.11",
    "esbuild": "^0.28.2",
    "eslint": "10.15.0",
    "playwright": "^1.65.1",
    "prettier": "3.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "5.1.2",
    "wrangler": "4.168.0"
  },
  "overrides": {
    "@openai/mcp-extensions": {
      "zod": "4.6.7"
    }
  }
}
